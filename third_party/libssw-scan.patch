+void Aligner::AlignBatch(const std::vector<std::string>& queries, const Filter& filter,
+                         const int32_t maskLen, std::vector<Alignment>* alignments,
+                         std::vector<uint16_t>* flags) const {
+  const size_t n = queries.size();
+  alignments->assign(n, Alignment());
+  flags->assign(n, 0);
+  if (!translation_matrix_ || reference_length_ == 0) return;  // Align returns false (0)
+  std::vector<int8_t*> tq(n, nullptr);
+  std::vector<const s_profile*> profs;
+  std::vector<size_t> idx;
+  for (size_t t = 0; t < n; ++t) {
+    int query_len = strlen(queries[t].c_str());
+    if (query_len == 0) continue;  // Align returns false (0), alignment untouched
+    tq[t] = new int8_t[query_len];
+    TranslateBase(queries[t].c_str(), query_len, tq[t]);
+    profs.push_back(ssw_init(tq[t], query_len, score_matrix_, score_matrix_size_, 2));
+    idx.push_back(t);
+  }
+  uint8_t flag = 0;
+  SetFlag(filter, &flag);
+  std::vector<s_align*> res(profs.size());
+  if (!profs.empty())
+    ssw_align_batch(profs.data(), profs.size(), translated_reference_, reference_length_,
+                    static_cast<int>(gap_opening_penalty_), static_cast<int>(gap_extending_penalty_),
+                    flag, filter.score_filter, filter.distance_filter, maskLen, res.data());
+  for (size_t u = 0; u < profs.size(); ++u) {
+    size_t t = idx[u];
+    int query_len = strlen(queries[t].c_str());
+    Alignment* a = &(*alignments)[t];
+    a->Clear();
+    ConvertAlignment(*res[u], query_len, a);
+    a->mismatches = CalculateNumberMismatch(a, translated_reference_, tq[t], query_len);
+    (*flags)[t] = res[u]->flag;
+    align_destroy(res[u]);
+    init_destroy(const_cast<s_profile*>(profs[u]));
+  }
+  for (size_t t = 0; t < n; ++t) delete[] tq[t];
+}
