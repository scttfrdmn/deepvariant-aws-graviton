+/* aws-realign#130 (b): SSW_DUMP=FILE records every ssw_align_scan call (inputs
+ * and outputs) for the GPU Smith-Waterman gate; SSW_GPU_IN=FILE replays the
+ * forward/reverse-pass results (score1, ends, begins) computed elsewhere, so
+ * only banded_sw runs here. Single-threaded replay harness use only. */
+static FILE* ssw_env_file(const char* var, const char* mode, FILE** f, int* init) {
+	if (!*init) { const char* p = getenv(var); *init = 1; if (p) *f = fopen(p, mode); }
+	return *f;
+}
+static FILE* ssw_dump_file(void) { static FILE* f = 0; static int i = 0; return ssw_env_file("SSW_DUMP", "wb", &f, &i); }
+static FILE* ssw_gin_file(void) { static FILE* f = 0; static int i = 0; return ssw_env_file("SSW_GPU_IN", "rb", &f, &i); }
